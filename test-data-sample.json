  "testElements": {
    "fillTests": [
      {
        "type": "fill",
        "selector": "#firstName",
        "value": "John",
        "description": "Fill first name field"
      },
      {
        "type": "fill",
        "selector": "#businessName",
        "value": "Test Business",
        "description": "Fill business name"
      },
      {
        "type": "fill_select",
        "selector": "#country",
        "searchValue": "United",
        "selectValue": "usa",
        "description": "Fill and select country"
      },
      {
        "type": "fill_enter",
        "selector": "#dropdown-enter",
        "value": "test value",
        "key": "Enter",
        "description": "Fill field and press Enter"
      }
    ],
    "clickTests": [
      {
        "type": "click",
        "selector": "button.btn-primary",
        "description": "Click primary button"
      },
      {
        "type": "click_radio",
        "selector": "#individual",
        "description": "Click radio button"
      },
      {
        "type": "click_checkbox",
        "selector": "#newsletter",
        "description": "Click checkbox"
      },
      {
        "type": "find_click",
        "searchField": "#paymentFind",
        "searchValue": "Visa",
        "description": "Find Visa in payment options and click"
      }
    ],
    "dropdownTests": [
      {
        "type": "simple_dropdown",
        "selector": "#country",
        "value": "usa",
        "description": "Select from simple dropdown"
      },
      {
        "type": "searchable_dropdown",
        "selector": "#search-dropdown",
        "searchValue": "app",
        "selectValue": "Apple",
        "description": "Search and select from dropdown"
      },
      {
        "type": "fill_and_select",
        "selector": "#dropdown-with-textbox",
        "value": "Product A",
        "description": "Fill field and select matching result"
      }
    ],
    "modalTests": [
      {
        "type": "open_modal",
        "triggerSelector": "button[onclick*='openModal']",
        "modalSelector": "#testModal",
        "description": "Open test modal"
      },
      {
        "type": "modal_interaction",
        "modalSelector": "#testModal",
        "actions": [
          {
            "type": "fill",
            "selector": "#modalInput",
            "value": "test value"
          },
          {
            "type": "click",
            "selector": ".btn-success"
          }
        ],
        "description": "Interact with modal content"
      },
      {
        "type": "close_modal",
        "modalSelector": "#testModal",
        "closeSelector": ".modal-close",
        "description": "Close modal"
      }
    ],
    "imageTests": [
      {
        "type": "image_upload",
        "selector": "#logoUpload",
        "fileName": "logo.png",
        "elementType": "logo",
        "description": "Upload business logo"
